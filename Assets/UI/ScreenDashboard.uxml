<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ScreenDashboard" class="flex-grow-1 display-flex">
        <ui:Label text="ZARZĄDZANIE KOPALNIAMI" class="title-label color-blue" />

        <ui:VisualElement class="panel-card">
            <ui:Label name="SiliconDepositLabel" text="Złoże Krzemu: Brak dostępu" class="label-hud mb-10" />
            <ui:Button name="BuySiliconPlotBtn" text="Kup Działkę Krzemu (100 000 USD)" class="btn-base btn-primary btn-wide" />
        </ui:VisualElement>

        <ui:VisualElement class="panel-card mb-0">
            <ui:Label name="CoalDepositLabel" text="Złoże Węgla: Brak dostępu" class="label-hud mb-10" />
            <ui:Button name="BuyCoalPlotBtn" text="Kup Działkę Węgla (50 000 USD)" class="btn-base btn-primary btn-wide" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>