.main-container {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
    padding: 15px;
    color: rgb(255, 255, 255);
}

.header-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.panel-container {
    background-color: rgb(45, 45, 45);
    padding: 15px;
    margin-bottom: 10px;
    border-radius: 5px;
}

.panel-hr {
    background-color: rgb(55, 45, 55);
    padding: 15px;
    border-width: 1px;
    border-color: rgb(100, 60, 100);
    border-radius: 5px;
}

.title-label {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.subtitle-label {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.label-hud {
    margin-bottom: 5px;
}

.btn-nav {
    margin-right: 10px;
    padding: 10px 20px;
    background-color: rgb(60, 60, 60);
    border-radius: 3px;
    color: rgb(255, 255, 255);
}
.btn-nav:hover { background-color: rgb(80, 80, 80); }
.btn-nav:active { background-color: rgb(100, 100, 100); }

.btn-action {
    padding: 10px;
    border-radius: 3px;
    color: rgb(255, 255, 255);
}
.btn-action:hover { opacity: 0.8; }
.btn-action:active { opacity: 0.6; }

.btn-wide {
    width: 300px;
    padding: 10px;
}

.btn-sell {
    padding: 5px 10px;
    background-color: rgb(50, 100, 50);
}
.btn-sell:hover { background-color: rgb(70, 120, 70); }
.btn-sell:active { background-color: rgb(90, 140, 90); }

.btn-route-silicon { background-color: rgb(70, 70, 100); margin-bottom: 5px; padding: 10px; }
.btn-route-coal { background-color: rgb(100, 70, 70); margin-bottom: 5px; padding: 10px; }
.btn-route-factory-in { background-color: rgb(70, 100, 70); margin-bottom: 5px; padding: 10px; }
.btn-route-factory-out { background-color: rgb(100, 70, 100); padding: 10px; }

.btn-hr-add { padding: 8px 15px; margin-right: 10px; background-color: rgb(60, 90, 60); }
.btn-hr-remove { padding: 8px 15px; background-color: rgb(90, 60, 60); }
.btn-hr-add:hover, .btn-hr-remove:hover { opacity: 0.8; }
.btn-hr-add:active, .btn-hr-remove:active { opacity: 0.6; }

.btn-back {
    padding: 10px 20px;
    background-color: rgb(150, 50, 50);
    display: none;
}
.btn-back:hover { background-color: rgb(170, 70, 70); }
.btn-back:active { background-color: rgb(190, 90, 90); }

.color-cash { color: rgb(133, 187, 101); -unity-font-style: bold; }
.color-alert { color: rgb(239, 83, 80); }
.color-light { color: rgb(200, 200, 200); -unity-font-style: italic; }
.color-blue { color: rgb(200, 200, 255); }
.color-pink { color: rgb(255, 200, 200); }
.color-green-light { color: rgb(200, 255, 200); }

.footer-container {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
    border-top-width: 1px;
    border-top-color: rgb(80, 80, 80);
    padding-top: 10px;
}

.row-align-center {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}
